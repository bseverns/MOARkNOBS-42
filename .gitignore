# Ignore macOS metadata files
.DS_Store

# Ignore firmware zip archive
firmwareZip.zip

# Ignore PlatformIO build folders
.pio/
.pio-home/
.pio-cache/

# Ignore editor swap files
*.swp

# Ignore compiled binaries
*.bin
*.elf

# Ignore release artifacts
dist/
docs/dist/
logs/

# Bridge deps live outside git; npm ci resurrects them
bridge/node_modules/
App/node_modules/
App/playwright-report/
App/test-results/

# Hardware CAD project/autosave artifacts (local-only)
hardware/**/*.epro
hardware/**/*.eprj
hardware/**/*autosave*
hardware/**/*AutoSave*
hardware/*_backup/
