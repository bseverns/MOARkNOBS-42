#!/usr/bin/env bash
# Run doctor with any supported local Python; macOS system Python can be too old.
set -euo pipefail

for python_bin in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$python_bin" >/dev/null 2>&1 && "$python_bin" -c 'import sys; raise SystemExit(sys.version_info < (3, 11))'; then
    exec "$python_bin" "$(dirname "$0")/doctor.py" "$@"
  fi
done

printf 'MN42 requires Python 3.11+ for doctor. Install it, then rerun tools/doctor.\n' >&2
exit 1
