{
    "configurations": [
        {
            "name": "PlatformIO",
            "configurationProvider": "platformio",
            "includePath": [
                "${workspaceFolder}/firmware/include",
                "${workspaceFolder}/firmware/src",
                "${workspaceFolder}/firmware/test",
                "${workspaceFolder}/firmware/lib",
                "${workspaceFolder}/firmware/lib/**",
                "${workspaceFolder}/firmware/.pio/libdeps/**",
                "${env:PLATFORMIO_CORE_DIR}/packages/framework-arduinoteensy/cores/teensy4",
                "${env:PLATFORMIO_CORE_DIR}/packages/framework-arduinoteensy/libraries/**",
                "${env:HOME}/.platformio/packages/framework-arduinoteensy/cores/teensy4",
                "${env:HOME}/.platformio/packages/framework-arduinoteensy/libraries/**",
                "${env:USERPROFILE}/.platformio/packages/framework-arduinoteensy/cores/teensy4",
                "${env:USERPROFILE}/.platformio/packages/framework-arduinoteensy/libraries/**"
            ],
            "browse": {
                "limitSymbolsToIncludedHeaders": true,
                "path": [
                    "${workspaceFolder}/firmware/include",
                    "${workspaceFolder}/firmware/src",
                    "${workspaceFolder}/firmware/lib",
                    "${workspaceFolder}/firmware/lib/**",
                    "${workspaceFolder}/firmware/.pio/libdeps/**"
                ]
            },
            "defines": [
                "USB_MIDI_SERIAL",
                "FASTLED_ALLOW_INTERRUPTS=0",
                "LED_DATA_PIN=6"
            ],
            "cppStandard": "gnu++17"
        }
    ],
    "version": 4
}
